{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "request": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "files.list"
            },
            "location": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "root"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "site"
                    },
                    "url": {
                      "type": "string",
                      "maxLength": 8192
                    }
                  },
                  "required": [
                    "kind",
                    "url"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "folder"
                    },
                    "id": {
                      "type": "object",
                      "properties": {
                        "drive": {
                          "type": "string",
                          "maxLength": 2048
                        },
                        "item": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        }
                      },
                      "required": [
                        "drive",
                        "item"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "next": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 8192
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "operation",
            "location",
            "next"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "files.download"
            },
            "id": {
              "type": "object",
              "properties": {
                "drive": {
                  "type": "string",
                  "maxLength": 2048
                },
                "item": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "required": [
                "drive",
                "item"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "operation",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "directory.read"
            }
          },
          "required": [
            "operation"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "version",
    "request"
  ],
  "additionalProperties": false
}
