{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "files.list"
            },
            "files": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "object",
                    "properties": {
                      "drive": {
                        "type": "string",
                        "maxLength": 2048
                      },
                      "item": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      }
                    },
                    "required": [
                      "drive",
                      "item"
                    ],
                    "additionalProperties": false
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "file",
                      "folder"
                    ]
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "mime": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "source_url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": ""
                      },
                      {
                        "type": "string",
                        "format": "uri"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "kind",
                  "size",
                  "mime",
                  "source_url"
                ],
                "additionalProperties": false
              }
            },
            "next": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 8192
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "operation",
            "files",
            "next"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "files.download"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "mime": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_url": {
              "anyOf": [
                {
                  "type": "string",
                  "const": ""
                },
                {
                  "type": "string",
                  "format": "uri"
                }
              ]
            },
            "data": {
              "type": "string",
              "maxLength": 34952536,
              "format": "base64",
              "contentEncoding": "base64",
              "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
            }
          },
          "required": [
            "operation",
            "name",
            "mime",
            "source_url",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "directory.read"
            },
            "signed_in_as": {
              "type": "string",
              "maxLength": 320
            },
            "people": {
              "maxItems": 20000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 320
                  },
                  "active": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "email",
                  "active"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "operation",
            "signed_in_as",
            "people"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "error"
            },
            "code": {
              "type": "string",
              "enum": [
                "unauthorized",
                "denied",
                "not_found",
                "rate_limited",
                "invalid_request",
                "invalid_response",
                "too_large",
                "unavailable"
              ]
            }
          },
          "required": [
            "operation",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "version",
    "result"
  ],
  "additionalProperties": false
}
